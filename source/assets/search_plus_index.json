---
layout: null
---
{
{% for record in site.records %}{{ record.url | relative_url | jsonify }}: {
  "title": {{ record.title | jsonify }},
  "keywords": {{ record.tags | join: ' ' | jsonify }},
  "url": {{ record.url | relative_url | jsonify }},
  "body": {{ record.content | strip_html | normalize_whitespace | jsonify }}
}{% unless forloop.last %},{% endunless %}{% endfor %}
}
